# CucCut AI proxy settings (loaded by systemd: cuccut-ai.service)
PORT=7820
# Groq API key from https://console.groq.com/keys (empty = subtitles disabled)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
PRICE_PER_HOUR=0.04
MONTHLY_BUDGET_USD=30
PER_IP_DAILY_MINUTES=30
ALLOWED_ORIGINS=https://cuccut.coffeesos.online
